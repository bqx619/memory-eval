# memeval 环境变量模板（复制为 .env 后填写；.env 已被 .gitignore 排除）
# 优先级：命令行旗标 > 进程环境 > .env。语法按 godotenv：支持 # 注释、export 前缀、引号、${VAR} 引用。
# MEMEVAL_* 只进入评测器进程，永远不会透传给被测系统；被测系统的变量
# 必须在其 manifest 的 env_passthrough 里逐个列出才会从本文件透传。

# ---------- 评测器：模型 provider（裁判 / 固定阅读器 / 决策对照） ----------
MEMEVAL_OPENAI_API_KEY=''  # OpenAI 兼容端点的 key（官方裁判 gpt-4o-2024-08-06、阅读器）
MEMEVAL_OPENAI_BASE_URL=''  # 可选；缺省 https://api.openai.com/v1
MEMEVAL_ANTHROPIC_API_KEY=''  # 可选；仅用于 Anthropic 阅读器 provider（--reader-provider anthropic）
MEMEVAL_ANTHROPIC_BASE_URL=''  # 可选；缺省 https://api.anthropic.com/v1
MEMEVAL_TYPESAFE_API_KEY=''  # TypeSafe（Jev 决策模型）；P5 起为唯一裁判通道，必填
MEMEVAL_TYPESAFE_BASE_URL=''  # 可选；缺省 https://api.typesafe.ai

# ---------- 评测器：裁判与阅读器缺省（均可被旗标覆盖） ----------
MEMEVAL_LLM_MODE=replay            # live | record | replay | record-once；replay 缺 cassette 直接失败
MEMEVAL_CASSETTE_DIR=''  # 可选；缺省 ~/.cache/memeval/cassettes
MEMEVAL_LLM_PARALLEL=4             # 评测器 LLM 并发上限
MEMEVAL_PARALLEL=''  # 缺省 1：run 的 episode 级并行 worker 数（1..16，P9 D6）；同一 episode 内用例仍顺序执行，结果按套件顺序装配，与串行逐位一致；--parallel 覆盖；超过宿主 CPU 数时警告
MEMEVAL_PRICES_FILE=config/llm_prices.json   # 价格表（2026-10-16 核实的官方定价）；缺省不计成本（显示 null）
MEMEVAL_READER_MODEL=gpt-6-luna            # 固定阅读器；OpenAI 指定的 4o 继任，费用最低
MEMEVAL_ANTHROPIC_EFFORT=low          # Anthropic 阅读器调用的 effort（其 temperature 不可用）
MEMEVAL_JUDGE_DECISION_MODEL=jev-1.14.0    # 唯一裁判：钉死的 TypeSafe Jev 版本（P5，2026-10-18 起 LLM 裁判已删除）
MEMEVAL_CACHE_DIR=''  # 可选；uv venv 等缓存目录，缺省 ~/.cache/memeval
MEMEVAL_EP_ROOT=''   # 宿主侧 episode 目录根；缺省 /private/tmp/memeval；每个 episode 目录以同路径 bind-mount 进 SUT 容器（P8），须为 Docker 守护进程可共享的本地目录
MEMEVAL_RUN_SEED=''  # 可选；64 位 hex；为空则每次随机并写入 report

# ---------- 被测系统（需在对应 manifest 的 env_passthrough 列出才会透传） ----------
OCTOPMEMORY_LLM_API_KEY=''  # octop-extract 变体直连自家 provider 的 key

# ---------- 测试专用（仅 go test 读取） ----------
MEMEVAL_OCTOP_IMAGE_TEST=''  # =1 时 octop-memory 的真实协议契约测试在容器后端运行（还需 docker 可达且 suts/octop-memory 环境已安装；P8 K7b，原 MEMEVAL_OCTOP_VENV 宿主 venv 门控已删除）
MEMEVAL_ORACLE_PYTHON=''  # 带 numpy（LongMemEval）与 nltk、regex（LoCoMo，P2 起）的 Python 解释器，用于上游评分脚本 oracle 对照；缺省 ~/.cache/memeval/longmemeval-oracle/.venv/bin/python
MEMEVAL_LOCOMO_INPUT=''  # 指向 data/upstream/locomo/locomo10.json 时运行 LoCoMo 真实数据统计测试（CC BY-NC，样例不随包）
MEMEVAL_HALUMEM_INPUT=''  # 指向 data/upstream/halumem/HaluMem-Medium.jsonl 时运行 HaluMem 真实数据统计测试（CC BY-NC-ND，样例只用合成占位）
MEMEVAL_PREFEVAL_INPUT=''  # 指向 data/upstream/prefeval/benchmark_dataset 时运行 PrefEval 真实数据统计测试（CC BY-NC，样例只用合成占位）
MEMEVAL_CONVOMEM_INPUT=''  # 指向 data/upstream/convomem/core_benchmark/evidence_questions 时运行 ConvoMem 真实数据统计测试（CC BY-NC，样例只用合成占位）
MEMEVAL_M2B_ACCEPTANCE=''  # =1 运行 M2b 离线验收测试
MEMEVAL_M3_ACCEPTANCE=''  # =1 运行 M3 离线验收测试

# ---- 容器后端（P8 K2，2026-10-18）：被测系统只在 Linux 容器内运行，评测器留在宿主 ----
MEMEVAL_DOCKER_CONTEXT=''  # 缺省 orbstack：docker CLI 的 --context（本机选中的是 default，所以必须显式指定；绝不自动启动守护进程）
MEMEVAL_DOCKER_CLI=''  # 缺省 docker：标准 docker CLI 路径或名称（任何兼容守护进程均可，代码不依赖 OrbStack 专有能力）
MEMEVAL_LINUX_BINARY=''  # 缺省 bin/memeval-linux-<arch>：交叉编译的静态 Linux 探针二进制（scripts/build_linux_memeval.sh），只读 bind-mount 进探针容器
MEMEVAL_CONTAINER_TMPFS_SIZE=''  # 缺省 1g：SUT 容器 /tmp tmpfs 上限（容器内 TMPDIR=/tmp）
MEMEVAL_CONTAINER_SHM_SIZE=''  # 缺省 512m：SUT 容器 /dev/shm 上限

# ---- 被测系统的 LLM 网关（P8 D10，2026-10-18）：沙箱内的 SUT 统一经此 OpenAI 兼容网关调用模型；embedding 仍用镜像内本地模型 ----
MEMEVAL_SUT_LLM_BASE_URL=''  # 如 http://gateway.example:8317/v1；gateway 网络模式只接受 http:// + 字面 IP（经单目标中继转发），https/域名需 open 模式；--sut-llm-base-url 覆盖
MEMEVAL_SUT_LLM_API_KEY=''  # 网关 API key（密钥：全程脱敏，不进 argv/日志/report）
MEMEVAL_SUT_LLM_MODEL=''  # 缺省 gpt-6-luna（低级别模型）；--sut-llm-model 或 manifest llm.model 另设
MEMEVAL_SUT_LLM_REASONING_EFFORT=''  # 缺省 low；--sut-llm-effort 或 manifest llm.reasoning_effort 另设
MEMEVAL_SUT_LLM_CONCURRENCY=''  # 缺省 8：gateway 模式下治理中继允许同时在途的网关请求数（P9 D2/D2''）；低于被测系统的扇出会让其 HTTP 客户端超时（报告 billing.sut.client_disconnects）；--sut-llm-concurrency 覆盖
MEMEVAL_SUT_LLM_RPM=''  # 缺省 0=不限：治理中继的每分钟请求令牌桶；--sut-llm-rpm 覆盖
MEMEVAL_SUT_LLM_BUDGET_TOKENS=''  # 缺省 0=不限：本次 run 被测系统 prompt+completion token 预算，耗尽时停在可 --resume 的状态（P9 D5）
MEMEVAL_SUT_LLM_MAX_PAUSE=''  # 缺省 30m：断路器累计暂停上限，超过即停止 run（退出码 4）并提示 --resume（P9 D3）

# ---- 运行日志（P7 W1-C1，2026-10-18）----
MEMEVAL_EPISODE_LOGS=''  # 缺省 1：每 episode 的 SUT stderr、边车输出、RPC 错误原文落盘到 <out>/logs/（只脱敏凭据）；0 关闭，等价 run --no-logs
MEMEVAL_LOG_FILE_CAP_BYTES=''  # 缺省 33554432：logs/ 下每个文件上限，超出保留头尾各一半并写省略标记

# ---- SUT 自身凭据（P8 起缺省不再使用：被测系统的 LLM 调用统一经上面的 MEMEVAL_SUT_LLM_* 网关，由 manifest llm.env 模板注入；下列键只在某个 open 变体显式用 env_passthrough 直连 provider 时才透传，评测器自身不读）----
OPENAI_API_KEY=''   # 仅 open 变体直连 OpenAI 时经 manifest env_passthrough 透传（如 suts/mem0/manifest-openai-embed.json 的 text-embedding-3-large 嵌入，P18）
HINDSIGHT_API_LLM_API_KEY=''   # 仅 Hindsight open 变体直连其 provider 时透传
