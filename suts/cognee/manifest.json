{
  "schema_version": "3",
  "name": "cognee",
  "variant": "none",
  "notes": "Cognee 零外发配置：本地 GLiNER 抽取实体与关系 + 本地 fastembed 嵌入，图谱（LadybugDB）与向量库（LanceDB）都在 episode 目录；不调用 LLM。",
  "adapter": {
    "kind": "python-bridge",
    "transport": "jsonrpc-stdio",
    "max_frame_bytes": 16777216,
    "request_timeout_s": 1800
  },
  "runtime": {
    "kind": "uv-python",
    "python": "3.12",
    "requirements": "requirements.in",
    "requirements_lock": "requirements.lock.txt",
    "prepare": [
      [
        "{python}",
        "{project}/prepare_models.py",
        "{env}/models"
      ]
    ],
    "base": "uv-python",
    "indexes": [
      {
        "url": "https://download.pytorch.org/whl/cpu",
        "strategy": "unsafe-best-match"
      }
    ],
    "apt": [
      "libssl3"
    ],
    "constraints": "requirements.constraints.txt"
  },
  "bridge": {
    "module": "adapter",
    "class": "Adapter",
    "config": {}
  },
  "process": {
    "command": [],
    "cwd": "{ep}/work",
    "env": {
      "LBUG_C_API_LIB_PATH": "{env}/models/lbug/lib/liblbug.so"
    },
    "env_passthrough": []
  },
  "sandbox": {
    "network": "none",
    "limits": {
      "timeout_s": 1800
    },
    "backend": "container"
  },
  "ready": {
    "strategy": "sync"
  },
  "declared": {
    "project_version": "1.6.5",
    "llm": "none (gliner_demo)",
    "embedding": "local install-time assets; runtime downloads disabled"
  },
  "telemetry_env": {
    "TELEMETRY_DISABLED": "1",
    "GRAPH_EXTRACTOR": "gliner_demo",
    "DATA_ROOT_DIRECTORY": "{ep}/data",
    "SYSTEM_ROOT_DIRECTORY": "{ep}/system",
    "CACHE_ROOT_DIRECTORY": "{ep}/cache",
    "HF_HOME": "{env}/models/hf",
    "FASTEMBED_CACHE_PATH": "{env}/models/fastembed",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "COGNEE_LOGS_DIR": "{ep}/logs",
    "COGNEE_REPOS_DIR": "{ep}/repos",
    "COGNEE_LOG_FILE": "false",
    "IMPROVE_AUTO_ENABLED": "false",
    "GLINER_AUTO_INSTALL": "false",
    "EMBEDDING_PROVIDER": "fastembed",
    "EMBEDDING_MODEL": "BAAI/bge-small-en-v1.5",
    "EMBEDDING_DIMENSIONS": "384",
    "TIKTOKEN_CACHE_DIR": "{env}/models/tiktoken",
    "GRAPH_DATABASE_SUBPROCESS_ENABLED": "false",
    "VECTOR_DB_SUBPROCESS_ENABLED": "false"
  },
  "llm": {
    "required": false,
    "env": {
      "LLM_PROVIDER": "openai",
      "LLM_ENDPOINT": "{llm.base_url}",
      "LLM_API_KEY": "{llm.api_key}",
      "LLM_MODEL": "{llm.model}"
    }
  }
}
